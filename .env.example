# Copy to .env. Every value here is optional -- the service runs without a .env at all.

# Path to the instance config. This is already the default, so set it only to serve a
# different file. Keep it relative: it resolves from the repo root in a virtualenv and
# from /app inside the container, so one value works for both. An absolute host path
# would not exist in the container.
# CLIMATE_SERVICE_CONFIG=./climate-service.yaml

# Public base URL, so STAC/openEO links are correct behind a reverse proxy.
# Without this, links are built from the request host and will point at the internal one.
# CLIMATE_SERVICE_BASE_URL=https://climate-demo.dhis2.org

# Copernicus CDS credentials, needed by `make populate` for the ERA5-Land datasets.
# CHIRPS3 and WorldPop are public and need none. Get a key from your profile at
# https://cds.climate.copernicus.eu, and accept the licence for each ERA5-Land dataset.
#
# These are optional here: if unset, `make populate` falls back to ~/.ecmwfdatastoresrc,
# the file the CDS documentation tells you to create. Set them if you would rather keep
# credentials with the project than in your home directory.
# ECMWF_DATASTORES_URL=https://cds.climate.copernicus.eu/api
# ECMWF_DATASTORES_KEY=your-api-key

# Workaround for a local PROJ database conflict, if `to_epsg()` returns None or you see
# "proj.db contains DATABASE.LAYOUT.VERSION.MINOR = 5 whereas a number >= 6 is expected".
# Point PROJ at the copy shipped inside this repo's virtualenv (virtualenv path only —
# the container is unaffected):
# PROJ_DATA=./.venv/lib/python3.12/site-packages/rasterio/proj_data
