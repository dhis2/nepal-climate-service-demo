# Copy to .env. Nothing here is needed to serve -- the container runs without a .env.
# These are read by `docker compose` for interpolation, and passed explicitly to the
# throwaway ingestion container (see "Ingesting data" in README.md).

# Host port to publish on. The container always listens on 8003.
# PORT=8003

# Public base URL, so STAC/openEO links are correct behind a reverse proxy.
# Without this, links are built from the request host and will point at the internal one.
# CLIMATE_SERVICE_BASE_URL=https://climate-demo.dhis2.org

# Copernicus Climate Data Store, for the ERA5-Land datasets.
# ECMWF_DATASTORES_URL=https://cds.climate.copernicus.eu/api
# ECMWF_DATASTORES_KEY=<KEY>

# Copernicus Data Space Ecosystem S3, for the CLMS GPP plugin. Register at
# https://dataspace.copernicus.eu/ then generate keys at
# https://eodata-s3keysmanager.dataspace.copernicus.eu/
# CDSE_S3_ACCESS_KEY=<ACCESS-KEY>
# CDSE_S3_SECRET_KEY=<SECRET-KEY>

# CHIRPS3 and WorldPop are public and need no credentials.
