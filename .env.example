# Copy to .env and set the absolute path to this repository's config.
CLIMATE_SERVICE_CONFIG=/path/to/nepal-climate-service-demo/climate-service.yaml

# Public base URL, so STAC/openEO links are correct behind a reverse proxy.
# Without this, links are built from the request host and will point at the internal one.
# CLIMATE_SERVICE_BASE_URL=https://climate-demo.dhis2.org

# Only needed on the machine that ingests data (see "Ingesting data" in README.md).
# The ERA5-Land datasets download from the Copernicus Climate Data Store; the CHIRPS3 and
# WorldPop datasets are public and need no credentials.
# Credentials live in ~/.ecmwfdatastoresrc rather than here.

# Workaround for a local PROJ database conflict, if `to_epsg()` returns None or you see
# "proj.db contains DATABASE.LAYOUT.VERSION.MINOR = 5 whereas a number >= 6 is expected".
# Point PROJ at the copy shipped inside this repo's virtualenv:
# PROJ_DATA=/path/to/nepal-climate-service-demo/.venv/lib/python3.12/site-packages/rasterio/proj_data
